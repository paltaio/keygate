# Public hostname. <slug>.<host> routes to that upstream; the bare host serves /admin and /<slug>/... paths.
KEYGATE_HOST=keygate.example.com

# First dashboard user, created only when the users table is empty.
KEYGATE_ADMIN_EMAIL=you@example.com
KEYGATE_ADMIN_PASSWORD=change-me-now
KEYGATE_ADMIN_NAME=You

# Optional
# PORT=3000
# KEYGATE_DATA_DIR=/data
# KEYGATE_LOG_RETENTION_DAYS=30
# KEYGATE_SESSION_DAYS=14
# KEYGATE_UPSTREAM_TIMEOUT_MS=300000
